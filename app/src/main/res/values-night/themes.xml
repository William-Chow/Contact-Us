<resources>
    <!-- Base application theme. -->
    <style name="Theme.ContactUs" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar matches the dark app header (Quiet Native). -->
        <item name="android:statusBarColor">#FF1C1C1E</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- SplashActivity theme. -->
    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:colorBackground">#D4EBF2</item>
        <!-- Splash background stays light in both modes, so keep dark status bar icons.
             android:statusBarColor is ignored from API 35, so this controls the contrast. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>